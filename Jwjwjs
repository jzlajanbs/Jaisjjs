local function updateWhitelistLabel()
    if #_G.whitelistedPlayers == 0 then
        whitelistLabel:SetContent("None")
    else
        local displayText = ""
        for i, playerName in ipairs(_G.whitelistedPlayers) do
            if i > 3 then
                displayText = displayText .. "..."
                break
            end
            if i > 1 then displayText = displayText .. ", " end
            displayText = displayText .. playerName
        end
        whitelistLabel:SetContent(displayText)
    end
end

local function updateBlacklistLabel()
    if #_G.blacklistedPlayers == 0 then
        blacklistLabel:SetContent("None")
    else
        local displayText = ""
        for i, playerName in ipairs(_G.blacklistedPlayers) do
            if i > 3 then
                displayText = displayText .. "..."
                break
            end
            if i > 1 then displayText = displayText .. ", " end
            displayText = displayText .. playerName
        end
        blacklistLabel:SetContent(displayText)
    end
end

