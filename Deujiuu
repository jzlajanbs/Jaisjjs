local function obterTextoJogador(jogador)
    local nomeLimpo = jogador.DisplayName:gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", "")
    if nomeLimpo == "" or nomeLimpo == jogador.Name then
        return jogador.Name
    else
        return nomeLimpo .. " | " .. jogador.Name
    end
end

_G.jogadoresListaBranca = _G.jogadoresListaBranca or {}
_G.jogadoresListaPreta = _G.jogadoresListaPreta or {}

local function estaNaListaBranca(jogador)
    for _, nome in ipairs(_G.jogadoresListaBranca) do
        if nome:lower() == jogador.Name:lower() then
            return true
        end
    end
    return false
end

local function estaNaListaPreta(jogador)
    for _, nome in ipairs(_G.jogadoresListaPreta) do
