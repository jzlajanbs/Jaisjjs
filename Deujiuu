})

local toggleAnelMorte = ConfiguracaoSection:AddToggle({
    Title = "Anel da Morte",
    Default = false,
    Callback = function(estado)
        _G.anelMorteAtivo = estado
        if estado then
            if not _G.conexaoAnelMorte then
                _G.conexaoAnelMorte = game:GetService("RunService").Heartbeat:Connect(function()
                    local personagem = verificarPersonagem()
                    local minhaPos = personagem and personagem:FindFirstChild("HumanoidRootPart") and personagem.HumanoidRootPart.Position
                    if minhaPos then
                        for _, jogador in ipairs(Jogadores:GetPlayers()) do
                            if jogador ~= JogadorLocal and not estaNaListaBranca(jogador) and jogadorEstaVivo(jogador) then
                                if (minhaPos - jogador.Character.HumanoidRootPart.Position).Magnitude <= (_G.alcanceAnelMorte or 20) then
                                    matarJogador(jogador)
                                end
                            end
                        end
                    end
                end)
            end
        else
            if _G.conexaoAnelMorte then
                _G.conexaoAnelMorte:Disconnect()
                _G.conexaoAnelMorte = nil
            end
        end
    end
})

