local function atualizarLabelsListas()
    if #_G.jogadoresListaBranca == 0 then
        labelListaBranca:SetContent("Nenhum")
    else
        local texto = ""
        for i, nome in ipairs(_G.jogadoresListaBranca) do
            if i > 3 then
                texto = texto .. "..."
                break
            end
            if i > 1 then texto = texto .. "\n" end
            texto = texto .. nome
        end
        labelListaBranca:SetContent(texto)
    end

    if #_G.jogadoresListaPreta == 0 then
        labelListaPreta:SetContent("Nenhum")
    else
        local texto = ""
        for i, nome in ipairs(_G.jogadoresListaPreta) do
            if i > 3 then
                texto = texto .. "..."
                break
            end
            if i > 1 then texto = texto .. "\n" end
            texto = texto .. nome
        end
        labelListaPreta:SetContent(texto)
    end
end

local ultimoContadorBranca = 0
local ultimoContadorPreta = 0

task.spawn(function()
    while true do
        if #_G.jogadoresListaBranca ~= ultimoContadorBranca or #_G.jogadoresListaPreta ~= ultimoContadorPreta then
            atualizarLabelsListas()
            ultimoContadorBranca = #_G.jogadoresListaBranca
            ultimoContadorPreta = #_G.jogadoresListaPreta
        end
        task.wait(0.2)
    end
end)
