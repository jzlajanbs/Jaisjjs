})

local toggleSemAnimacao = ConfiguracaoSection:AddToggle({
    Title = "Soco Sem Animação",
    Default = false,
    Callback = function(estado)
        if estado then
            local animacoesBloqueadas = {
                ["rbxassetid://3638729053"] = true,
                ["rbxassetid://3638767427"] = true,
            }

            local function pararAnimacoesBloqueadas(humanoide)
                for _, track in pairs(humanoide:GetPlayingAnimationTracks()) do
                    if track.Animation then
                        local animId = track.Animation.AnimationId
                        local animNome = track.Name:lower()
                        if animacoesBloqueadas[animId] or animNome:match("punch") or animNome:match("attack") or animNome:match("right") then
                            track:Stop()
                        end
                    end
                end
            end

            local function configurarBloqueioAnimacao()
                local char = JogadorLocal.Character
                if not char or not char:FindFirstChild("Humanoid") then return end
                local humanoide = char:FindFirstChild("Humanoid")

                pararAnimacoesBloqueadas(humanoide)

                if not _G.ConexaoAnimBloqueada then
                    _G.ConexaoAnimBloqueada = humanoide.AnimationPlayed:Connect(function(track)
                        if track.Animation then
                            local animId = track.Animation.AnimationId
                            local animNome = track.Name:lower()
                            if animacoesBloqueadas[animId] or animNome:match("punch") or animNome:match("attack") or animNome:match("right") then
                                track:Stop()
                            end
                        end
                    end)
                end
            end

            configurarBloqueioAnimacao()

            _G.LoopAutoSoco = true
            task.spawn(function()
                while _G.LoopAutoSoco do
                    local char = JogadorLocal.Character
                    if char and char:FindFirstChild("Humanoid") then
                        pararAnimacoesBloqueadas(char.Humanoid)
                    end

                    local soco = JogadorLocal.Backpack:FindFirstChild("Punch") or (char and char:FindFirstChild("Punch"))
                    if soco then
                        if soco.Parent ~= char then
                            soco.Parent = char
                        end
                        JogadorLocal.muscleEvent:FireServer("punch", "rightHand")
                        JogadorLocal.muscleEvent:FireServer("punch", "leftHand")
                    end
                    task.wait(0.01)
                end
            end)

            if not _G.ConexaoPersonagemAdicionado then
                _G.ConexaoPersonagemAdicionado = JogadorLocal.CharacterAdded:Connect(function()
                    task.wait(1)
                    configurarBloqueioAnimacao()
                end)
            end
        else
            _G.LoopAutoSoco = false
            if _G.ConexaoAnimBloqueada then _G.ConexaoAnimBloqueada:Disconnect() _G.ConexaoAnimBloqueada = nil end
        end
    end
})

local function desabilitarOvoProteina()
    pcall(function()
        local mochila = JogadorLocal:WaitForChild("Backpack")
        local ovoProteina = mochila:FindFirstChild("Protein Egg")
        
        if ovoProteina then
            if ovoProteina.Enabled == false and ovoProteina.CanBeDropped == false then
                return
            else
                ovoProteina:Destroy()
                task.wait(0.1)
            end
        end
    
        local novoOvo = Instance.new("Tool")
        novoOvo.Name = "Protein Egg"
        novoOvo.Enabled = false
        novoOvo.CanBeDropped = false
        novoOvo.RequiresHandle = false
        novoOvo.Parent = mochila
    end)
end

local function monitorarOvoProteina()
    while true do
        desabilitarOvoProteina()
        task.wait(0.5)
    end
end

JogadorLocal.CharacterAdded:Connect(function()
    task.wait(1)
    desabilitarOvoProteina()
end)

