local function verificarPersonagem()
    if not JogadorLocal.Character then
        repeat task.wait() until JogadorLocal.Character
    end
    return JogadorLocal.Character
end

local function pegarFerramenta()
    for _, v in pairs(JogadorLocal.Backpack:GetChildren()) do
        if v.Name == "Punch" and JogadorLocal.Character:FindFirstChild("Humanoid") then
            JogadorLocal.Character.Humanoid:EquipTool(v)
        end
    end
    JogadorLocal.muscleEvent:FireServer("punch", "leftHand")
    JogadorLocal.muscleEvent:FireServer("punch", "rightHand")
end

local function jogadorEstaVivo(jogador)
    return jogador and jogador.Character
       and jogador.Character:FindFirstChild("HumanoidRootPart")
       and jogador.Character:FindFirstChild("Humanoid")
       and jogador.Character.Humanoid.Health > 0
end

local function matarJogador(alvo)
    if not jogadorEstaVivo(alvo) then return end
    local personagem = verificarPersonagem()
    if personagem and personagem:FindFirstChild("LeftHand") then
        pcall(function()
            firetouchinterest(alvo.Character.HumanoidRootPart, personagem.LeftHand, 0)
            firetouchinterest(alvo.Character.HumanoidRootPart, personagem.LeftHand, 1)
            pegarFerramenta()
        end)
    end
end

local function atualizarDropdownListaBranca()
    local jogadoresLista = Jogadores:GetPlayers()
    local valoresDropdown = {}
    
    for _, jogador in ipairs(jogadoresLista) do
        if jogador ~= JogadorLocal then
            table.insert(valoresDropdown, obterTextoJogador(jogador))
        end
    end
    
    if dropdownListaBranca then
        dropdownListaBranca:SetValues(valoresDropdown)
    end
end

