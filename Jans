local Renascimentos = Window:AddTab({
    Title = "Farmar",
    Icon = "refresh-cw"
})

local MainSection = Renascimentos:AddSection({
    Title = "Farmar Força"
})

MainSection:AddButton({
    Title = "Gamepass AutoLift",
    Callback = function()
        local gamepassFolder = game:GetService("ReplicatedStorage").gamepassIds
        local player = game:GetService("Players").LocalPlayer
        for _, gamepass in pairs(gamepassFolder:GetChildren()) do
            local value = Instance.new("IntValue")
            value.Name = gamepass.Name
            value.Value = gamepass.Value
            value.Parent = player.ownedGamepasses
        end
    end
})

local autoWeightSwitch = MainSection:AddToggle({
    Title = "Farmar com o Peso",
    Default = false,
    Callback = function(Value)
        _G.AutoWeight = Value
        if Value then
            local weightTool = game.Players.LocalPlayer.Backpack:FindFirstChild("Weight")
            if weightTool then
                game.Players.LocalPlayer.Character.Humanoid:EquipTool(weightTool)
            end
        else
            local character = game.Players.LocalPlayer.Character
            local equipped = character:FindFirstChild("Weight")
            if equipped then
                equipped.Parent = game.Players.LocalPlayer.Backpack
            end
        end
        task.spawn(function()
            while _G.AutoWeight do
                if not _G.AutoWeight then break end
                game:GetService("Players").LocalPlayer.muscleEvent:FireServer("rep")
                task.wait(0.1)
            end
        end)
    end
})

_G.AutoFlexoes = false
_G.ativoSocoRapido = false
_G.FlexoesRapidas = false
_G.SocoRapido = false
_G.autoFarm = false

local function equiparSoco()
    local jogador = game.Players.LocalPlayer
    local soco = jogador.Backpack:FindFirstChild("Punch")
    if soco and not jogador.Character:FindFirstChild("Punch") then
        if soco:FindFirstChild("attackTime") then
            soco.attackTime.Value = 0
        end
        jogador.Character.Humanoid:EquipTool(soco)
    end
end

local function equiparFlexoes()
    local jogador = game.Players.LocalPlayer
    local flexoes = jogador.Backpack:FindFirstChild("Pushups")
    if flexoes and not jogador.Character:FindFirstChild("Pushups") then
        if flexoes:FindFirstChild("repTime") then
            flexoes.repTime.Value = 0
        end
        jogador.Character.Humanoid:EquipTool(flexoes)
    end
end

local togglePedraFarmar = MainSection:AddToggle({
    Title = "Bater na Pedra e Farmar Automaticamente",
    Default = false,
    Callback = function(Valor)
        _G.AutoFlexoes = Valor
        _G.ativoSocoRapido = Valor
        _G.FlexoesRapidas = Valor
        _G.SocoRapido = Valor
        _G.autoFarm = Valor
        
        if Valor then
            equiparSoco()
            equiparFlexoes()
            
            task.spawn(function()
                while _G.autoFarm do
                    if not _G.autoFarm then break end
                    
                    equiparSoco()
                    equiparFlexoes()
                    
                    local jogador = game.Players.LocalPlayer
                    
                    jogador.muscleEvent:FireServer("punch", "rightHand")
                    jogador.muscleEvent:FireServer("punch", "leftHand")
                    
                    local personagem = jogador.Character
                    if personagem then
                        local ferramentaSoco = personagem:FindFirstChild("Punch")
                        if ferramentaSoco then
                            ferramentaSoco:Activate()
                        end
                    end
                    
                    jogador.muscleEvent:FireServer("rep")
                    
                    if jogador.Durability.Value >= 10000000 then
                        for _, v in pairs(game:GetService("Workspace").machinesFolder:GetDescendants()) do
                            if v.Name == "neededDurability" and v.Value == 10000000 and 
                               personagem:FindFirstChild("LeftHand") and personagem:FindFirstChild("RightHand") then
                                firetouchinterest(v.Parent.Rock, personagem.RightHand, 0)
                                firetouchinterest(v.Parent.Rock, personagem.RightHand, 1)
                                firetouchinterest(v.Parent.Rock, personagem.LeftHand, 0)
                                firetouchinterest(v.Parent.Rock, personagem.LeftHand, 1)
                            end
                        end
                    end
                    
                    task.wait(0)
                end
            end)
        else
            local personagem = game.Players.LocalPlayer.Character
            local mochila = game.Players.LocalPlayer.Backpack
            
            local soco = personagem:FindFirstChild("Punch")
            if soco then
                soco.Parent = mochila
                if soco:FindFirstChild("attackTime") then
                    soco.attackTime.Value = 0.35
                end
            end
            
            local flexoes = personagem:FindFirstChild("Pushups")
            if flexoes then
                flexoes.Parent = mochila
                if flexoes:FindFirstChild("repTime") then
                    flexoes.repTime.Value = 1
                end
            end
        end
    end
})

local autoComerAtivo = false

local function comerOvoProteina()
    local jogador = game.Players.LocalPlayer
    local mochila = jogador:WaitForChild("Backpack")
    local personagem = jogador.Character or jogador.CharacterAdded:Wait()

    local ovo = mochila:FindFirstChild("Protein Egg")
    if ovo then
        ovo.Parent = personagem
        pcall(function()
            ovo:Activate()
        end)
    end
end

task.spawn(function()
    while true do
        if autoComerAtivo then
            comerOvoProteina()
            task.wait(1800)
        else
            task.wait(1)
        end
    end
end)

local autoEatEnabled = false

local function eatProteinEgg()
    local player = game.Players.LocalPlayer
    local backpack = player:WaitForChild("Backpack")
    local character = player.Character or player.CharacterAdded:Wait()
    local egg = backpack:FindFirstChild("Protein Egg")
    if egg then
        egg.Parent = character
        pcall(function()
            egg:Activate()
        end)
    end
end

task.spawn(function()
    while true do
        if autoEatEnabled then
            eatProteinEgg()
            task.wait(1800)
        else
            task.wait(1)
        end
    end
end)

