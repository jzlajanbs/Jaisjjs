local RenascimentosSection = Renascimentos:AddSection({
    Title = "Auto Renascimentos"
})

local valorObjetivoRenascimento = 0

local txtObjetivoRenascimento = RenascimentosSection:AddTextbox({
    Title = "Objetivo de Renascimento",
    Placeholder = "Digite o objetivo",
    Finished = true,
    Callback = function(texto)
        local novoValor = tonumber(texto)
        if novoValor and novoValor > 0 then
            valorObjetivoRenascimento = novoValor
            
            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = "Objetivo Atualizado",
                Text = "Novo objetivo: " .. tostring(valorObjetivoRenascimento) .. " renascimentos",
                Duration = 3
            })
        else
            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = "Erro",
                Text = "Digite um valor maior que 0",
                Duration = 3
            })
        end
    end
})

local toggleObjetivoRenascimento = RenascimentosSection:AddToggle({
    Title = "Farmar até o Objetivo",
    Default = false,
    Callback = function(estado)
        _G.ativoObjetivoRenascimento = estado
        
        if estado then
            if _G.ativoRenascimentoInfinito and toggleRenascimentoInfinito then
                toggleRenascimentoInfinito:SetValue(false)
                _G.ativoRenascimentoInfinito = false
            end
            
            task.spawn(function()
                while _G.ativoObjetivoRenascimento and task.wait(0.1) do
                    local renascimentosAtuais = game.Players.LocalPlayer.leaderstats.Rebirths.Value
                    
                    if renascimentosAtuais >= valorObjetivoRenascimento then
                        toggleObjetivoRenascimento:SetValue(false)
                        _G.ativoObjetivoRenascimento = false
                        
                        game:GetService("StarterGui"):SetCore("SendNotification", {
                            Title = "Objetivo Alcançado!",
                            Text = "Você alcançou " .. tostring(valorObjetivoRenascimento) .. " renascimentos",
                            Duration = 5
                        })
                        
                        break
                    end
                    
                    game:GetService("ReplicatedStorage").rEvents.rebirthRemote:InvokeServer("rebirthRequest")
                end
            end)
        end
    end
})

local toggleRenascimentoInfinito = RenascimentosSection:AddToggle({
    Title = "Farmar Rebirth Infinitamente",
    Default = false,
    Callback = function(estado)
        _G.ativoRenascimentoInfinito = estado
        
        if estado then
            if _G.ativoObjetivoRenascimento and toggleObjetivoRenascimento then
                toggleObjetivoRenascimento:SetValue(false)
                _G.ativoObjetivoRenascimento = false
            end
            
            task.spawn(function()
                while _G.ativoRenascimentoInfinito and task.wait(0.1) do
                    game:GetService("ReplicatedStorage").rEvents.rebirthRemote:InvokeServer("rebirthRequest")
                end
            end)
        end
    end
})

