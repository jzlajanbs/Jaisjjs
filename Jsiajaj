})

local SelectedTool = nil
local AutoFarm = false

local toolDropdown = MainSection:AddDropdown({
    Title = "Selecionar Ferramenta",
    Values = {"Weight", "Pushups", "Situps", "Handstands", "Fast Punch", "Stomp", "Ground Slam"},
