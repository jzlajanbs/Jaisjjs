    Title = "Selecionar Pedra",
    Values = {"Tiny Rock", "Starter Island", "Punching Rock", "Golden Rock", "Frost Rock", "Mythical Rock", "Eternal Rock", "Legend Rock", "Muscle King Rock", "Jungle Rock"},
