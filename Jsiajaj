local togglePesoAuto = RenascimentosSection:AddToggle({
    Title = "Farmar com o Peso",
    Default = false,
    Callback = function(Valor)
        _G.PesoAuto = Valor
        
        if Valor then
            local pesoFerramenta = game.Players.LocalPlayer.Backpack:FindFirstChild("Weight")
            if pesoFerramenta then
                game.Players.LocalPlayer.Character.Humanoid:EquipTool(pesoFerramenta)
            end
        else
            local personagem = game.Players.LocalPlayer.Character
            local equipado = personagem:FindFirstChild("Weight")
            if equipado then
                equipado.Parent = game.Players.LocalPlayer.Backpack
            end
        end
        
        task.spawn(function()
            while _G.PesoAuto do
                if not _G.PesoAuto then break end
                game:GetService("Players").LocalPlayer.muscleEvent:FireServer("rep")
                task.wait(0.1)
            end
        end)
    end
})

local toggleTravarPersonagem = RenascimentosSection:AddToggle({
    Title = "Travar Personagem",
    Default = false,
    Callback = function(Valor)
        if Valor then
            local posicaoAtual = game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame
            getgenv().travamentoPosicao = game:GetService("RunService").Heartbeat:Connect(function()
                if game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = posicaoAtual
                end
            end)
        else
            if getgenv().travamentoPosicao then
                getgenv().travamentoPosicao:Disconnect()
                getgenv().travamentoPosicao = nil
            end
        end
    end
})
